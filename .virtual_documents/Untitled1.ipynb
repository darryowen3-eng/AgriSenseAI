import pandas as pd
import numpy as np

from sklearn.model_selection import GroupShuffleSplit
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.metrics import (
    mean_absolute_error,
    root_mean_squared_error,
    r2_score
)

from xgboost import XGBRegressor
from lightgbm import LGBMRegressor

# ============================================================
# CONFIG
# ============================================================

DATA_PATH = "data/master/agrisense_master_v5.csv"

RANDOM_STATE = 42
TEST_SIZE = 0.20


# ============================================================
# LOAD DATA
# ============================================================

df = pd.read_csv(DATA_PATH)

print("=" * 70)
print("AgriSense AI - Geographic Validation")
print("=" * 70)

print(f"\nDataset shape: {df.shape}")


# ============================================================
# FEATURES
# ============================================================

categorical_features = [
    "crop",
    "province",
    "district"
]

numeric_features = [
    "farm_size_ha",
    "planting_month",

    "rainfall_planting_month",
    "rainfall_1_month_before",
    "rainfall_2_months_before",
    "rainfall_3_months_before",
    "rainfall_preplant_3m_total",
    "rainfall_preplant_3m_mean",
    "preplant_rain_months_available",

    "soil_ph",
    "soil_organic_carbon_g_kg",
    "soil_nitrogen_g_kg",
    "soil_clay_percent",
    "soil_sand_percent",
    "soil_silt_percent",

    "ndvi_preplant_mean",
    "ndvi_preplant_max",
    "ndvi_preplant_min",
    "ndvi_preplant_std",
    "ndvi_preplant_median",
    "ndvi_preplant_first",
    "ndvi_preplant_last",
    "ndvi_preplant_observations",
    "ndvi_preplant_change"
]

target = "yield_tonnes_per_ha"


X = df[categorical_features + numeric_features]
y = df[target]


# ============================================================
# GEOGRAPHIC SPLIT
# ============================================================

groups = df["district"].astype(str)

splitter = GroupShuffleSplit(
    n_splits=1,
    test_size=TEST_SIZE,
    random_state=RANDOM_STATE
)

train_idx, test_idx = next(
    splitter.split(X, y, groups=groups)
)

X_train = X.iloc[train_idx]
X_test = X.iloc[test_idx]

y_train = y.iloc[train_idx]
y_test = y.iloc[test_idx]


print("\nTRAIN / TEST")
print("-" * 70)

print(f"Train rows: {len(X_train)}")
print(f"Test rows : {len(X_test)}")

print(f"Train districts: {X_train['district'].nunique()}")
print(f"Test districts : {X_test['district'].nunique()}")


train_districts = set(X_train["district"])
test_districts = set(X_test["district"])

overlap = train_districts.intersection(test_districts)

print(f"District overlap: {len(overlap)}")

if len(overlap) == 0:
    print("✓ No district appears in both train and test.")
else:
    print("WARNING: district overlap detected.")


# ============================================================
# PREPROCESSING
# ============================================================

numeric_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="median")
    )
])


categorical_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="most_frequent")
    ),
    (
        "encoder",
        OneHotEncoder(
            handle_unknown="ignore",
            sparse_output=False
        )
    )
])


preprocessor = ColumnTransformer([
    (
        "numeric",
        numeric_pipeline,
        numeric_features
    ),
    (
        "categorical",
        categorical_pipeline,
        categorical_features
    )
])


# ============================================================
# MODEL
# ============================================================

model = LGBMRegressor(
    n_estimators=500,
    learning_rate=0.05,
    max_depth=6,
    num_leaves=31,
    subsample=0.8,
    colsample_bytree=0.8,
    objective="regression",
    random_state=RANDOM_STATE,
    n_jobs=-1
)



pipeline = Pipeline([
    ("preprocessor", preprocessor),
    ("model", model)
])


# ============================================================
# TRAIN
# ============================================================

print("\nTraining geographic model...")

pipeline.fit(X_train, y_train)

print("Training complete.")


# ============================================================
# PREDICTION
# ============================================================

predictions = pipeline.predict(X_test)


# ============================================================
# METRICS
# ============================================================

mae = mean_absolute_error(
    y_test,
    predictions
)

rmse = root_mean_squared_error(
    y_test,
    predictions
)

r2 = r2_score(
    y_test,
    predictions
)


print("\n" + "=" * 70)
print("GEOGRAPHIC VALIDATION RESULTS")
print("=" * 70)

print(f"MAE  : {mae:.4f} tonnes/ha")
print(f"RMSE : {rmse:.4f} tonnes/ha")
print(f"R²   : {r2:.4f}")


# ============================================================
# DISTRICT RESULTS
# ============================================================

results = X_test.copy()

results["actual_yield"] = y_test.values
results["predicted_yield"] = predictions

results["absolute_error"] = (
    results["actual_yield"]
    - results["predicted_yield"]
).abs()


district_results = (
    results
    .groupby("district")
    .agg(
        records=("actual_yield", "count"),
        actual_mean=("actual_yield", "mean"),
        predicted_mean=("predicted_yield", "mean"),
        mae=("absolute_error", "mean")
    )
    .sort_values("mae", ascending=False)
)


print("\nWORST DISTRICTS BY MAE")
print("-" * 70)

print(
    district_results.head(15).to_string()
)


# ============================================================
# CROP RESULTS
# ============================================================

crop_results = (
    results
    .groupby("crop")
    .agg(
        records=("actual_yield", "count"),
        actual_mean=("actual_yield", "mean"),
        predicted_mean=("predicted_yield", "mean"),
        mae=("absolute_error", "mean")
    )
    .sort_values(
        "records",
        ascending=False
    )
)


print("\nCROP PERFORMANCE")
print("-" * 70)

print(
    crop_results.head(15).to_string()
)


print("\n" + "=" * 70)
print("DONE")
print("=" * 70)




